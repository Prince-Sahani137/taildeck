# Keep LF endings for anything that runs on Linux, even when cloned on Windows.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
# PowerShell is happiest with CRLF.
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ico binary
