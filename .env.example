# TailDeck configuration. Copy to .env and edit:   cp .env.example .env
# Keep this file private:                           chmod 600 .env
# Quote any value that contains spaces (the Linux run scripts source this file).
# Windows: paths are fine as-is, e.g. FILES_DIR=C:\Users\you\Downloads

PROJECT_NAME=TailDeck

# --- Panel server -----------------------------------------------------------
# 127.0.0.1 (default) is right when you front it with `tailscale serve`.
# Use "tailscale" to bind this node's tailnet IPv4 instead (plain-HTTP access).
PANEL_BIND=127.0.0.1
PANEL_PORT=6100

# --- Credentials (REQUIRED) ---------------------------------------------------
# One login for the panel and the loopback console backends.
# Generate a password with:  openssl rand -hex 16
PANEL_USER=admin
PANEL_PASSWORD=CHANGE_ME

# --- Console backends (loopback only) ----------------------------------------
WS_HYPR_HOST=127.0.0.1
WS_HYPR_PORT=6101
WS_XFCE_HOST=127.0.0.1
WS_XFCE_PORT=6102
TERM_HOST=127.0.0.1
TERM_PORT=6103

# Real VNC servers the websockify proxies connect to.
# VNC_XFCE_PORT defaults to 5902 on Linux (TigerVNC :2) and 5900 on Windows/macOS.
VNC_HYPR_PORT=5900
# VNC_XFCE_PORT=5902

# noVNC web files. Linux default: /usr/share/novnc. Windows default: the ./novnc
# folder (windows\setup.ps1 -DownloadNoVNC puts it there).
# NOVNC_DIR=/usr/share/novnc

# Shell started by the browser terminal. Default: $SHELL on Linux, PowerShell on Windows.
# TERM_SHELL=/bin/bash
# Full path to ttyd if it is not on PATH (Windows: C:\Tools\ttyd.exe)
# TTYD_BIN=ttyd

# Linux only: X display of the virtual XFCE desktop (thumbnails / no-blank script)
# XFCE_DISPLAY=:2

# --- Workspaces (UI tabs) -------------------------------------------------------
# Which tabs to show: any of hypr, xfce, term.
# Default: hypr,xfce,term on Linux; xfce,term on Windows/macOS.
# WORKSPACES=xfce,term
# Rename a tab, e.g. the "xfce" tab is your native desktop on Windows:
# WS_XFCE_LABEL=Desktop
# WS_XFCE_DESC=Your desktop in the browser.

# --- Service manager -------------------------------------------------------------
# auto (default): systemd user units on Linux when available, otherwise TailDeck
# starts and supervises websockify/ttyd itself (always the case on Windows).
# SERVICE_MANAGER=auto
# Optional custom service definitions for the built-in manager (see services.example.json).
# SERVICES_FILE=services.json

# Full path to tailscale if it is not on PATH
# TAILSCALE_BIN=C:\Program Files\Tailscale\tailscale.exe

# --- Files tab -----------------------------------------------------------------
# FILES_DIR defaults to ~/Downloads
# FILES_DIR=/path/to/shared/folder
MAX_UPLOAD=536870912

# --- HTTPS --------------------------------------------------------------------
# Optional. Auto-detected from `tailscale status`; set it to override, e.g.
# HTTPS_ORIGIN=https://my-host.my-tailnet.ts.net

# --- Sampling / caching ---------------------------------------------------------
# Desktop thumbnail size on Windows/macOS (fraction of the screen)
# THUMB_SCALE=0.35
THUMB_TTL=5
STATS_TTL=2
HISTORY_INTERVAL=3
HISTORY_SIZE=400
